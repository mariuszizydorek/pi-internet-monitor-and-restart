[Unit]
Description=Netwatch Ookla speed test
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/netwatch/service.env
Environment=HOME=/var/lib/netwatch
Environment=LANG=C.UTF-8
ExecStart=/opt/netwatch/venv/bin/netwatch-speedtest
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
